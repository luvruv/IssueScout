# ── Environment & secrets ──
.env
.venv/
__pycache__/
*.pyc
*.log

# ── Large / generated data (not for git) ──
data/raw/
data/*.db
data/docs/
data/kits/
data/emb_cache.pkl
data/last_plan.json
data/scored_open.pkl
data/llm_errors.log
data/*.tmp

# ── ML models (re-train with `python cli.py train all`) ──
models/

# ── AI tool configs ──
.claude/
.agents/

# ── Test / IDE caches ──
.pytest_cache/
*.egg-info/
dist/
build/
.idea/
.vscode/

# ── KEEP in git (evidence & evaluation datasets) ──
# report/           → all figures, CSVs, metrics.json, RESULTS.md
# data/processed/   → manual_label_sample.csv, repo_flags.csv
# data/eval/        → rag_questions.json, rag_questions.template.json, rag_questions_heldout.json
# data/outcomes.jsonl, data/feedback.jsonl
# repo_lists/       → modular repo list .txt files (ai_ml.txt, gsoc_lfx.txt, custom_template.txt)
# docs/             → PROJECT_ARCHITECTURE.md, RESPONSIBLE_AI.md
